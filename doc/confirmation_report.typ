  columns: (22%, 17%, 19%, 20%, 22%),
  align: (left, right, right, right, right),
  table.header([*测试样本*], [*原始分辨率*], [*原图文件体积*], [*对齐切片体积 (q95)*], [*上行载荷削减幅度*]),
  [#mono(`test_img.jpg`)], [1920×1080], [385.2 KB], [5.81 KB], [98.49%（缩减 66×）],
  [#mono(`2.jpg`)], [1140×456], [2030.8 KB], [12.73 KB], [*99.37%（缩减 160×）*],
